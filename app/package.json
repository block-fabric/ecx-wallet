{
  "name": "@ecx/app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Wallet UI: SvelteKit static app (adapter-static, SSR off, hash router), packaged into the extension.",
  "scripts": {
    "build": "vite build && node scripts/mv3-postbuild.mjs build",
    "dev": "vite dev",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "@types/chrome": "0.3.5",
    "svelte": "5.57.2",
    "svelte-check": "4.7.7",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
